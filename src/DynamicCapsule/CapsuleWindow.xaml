<Window x:Class="DynamicCapsule.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dynamic Capsule"
        Width="530"
        Height="286"
        Left="-10000"
        Top="-10000"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        MouseLeftButtonUp="OnWindowMouseLeftButtonUp"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="MediaButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="32" />
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Margin"
                    Value="2,0" />
            <Setter Property="Background"
                    Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontFamily"
                    Value="{StaticResource CapsuleFont}" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#4DFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EventActionButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="26" />
            <Setter Property="Height"
                    Value="26" />
            <Setter Property="Background"
                    Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="FontFamily"
                    Value="{StaticResource CapsuleFont}" />
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Background"
                                        Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpandedMediaButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource MediaButtonStyle}">
            <Setter Property="Width"
                    Value="46" />
            <Setter Property="Height"
                    Value="46" />
            <Setter Property="Margin"
                    Value="8,0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="FontSize"
                    Value="21" />
        </Style>
        <Style x:Key="PrimaryMediaButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ExpandedMediaButtonStyle}">
            <Setter Property="Width"
                    Value="54" />
            <Setter Property="Height"
                    Value="54" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize"
                    Value="27" />
        </Style>
        <Style x:Key="QuickMenuButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Height"
                    Value="28" />
            <Setter Property="Margin"
                    Value="2" />
            <Setter Property="Padding"
                    Value="8,0" />
            <Setter Property="Background"
                    Value="#18FFFFFF" />
            <Setter Property="BorderBrush"
                    Value="#28FFFFFF" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily"
                    Value="{StaticResource CapsuleFont}" />
            <Setter Property="FontSize"
                    Value="10.5" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="QuickButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="QuickButtonSurface"
                                        Property="Background"
                                        Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="QuickButtonSurface"
                                        Property="Background"
                                        Value="#48FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickMenuDangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource QuickMenuButtonStyle}">
            <Setter Property="Foreground"
                    Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush"
                    Value="#44FF7777" />
            <Setter Property="Background"
                    Value="#16FF7777" />
        </Style>
        <Style x:Key="TopStashArrowButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Width"
                    Value="30" />
            <Setter Property="Height"
                    Value="14" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="Focusable"
                    Value="False" />
            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}" />
            <Setter Property="Opacity"
                    Value="0.62" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ArrowSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <Path Width="10"
                                  Height="5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,5 L 5,0 L 10,5"
                                  Stroke="#E8EDFF"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.6" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Opacity"
                                        Value="1" />
                                <Setter TargetName="ArrowSurface"
                                        Property="Background"
                                        Value="#385B6EF5" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ArrowSurface"
                                        Property="Background"
                                        Value="#665B6EF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideTopStashArrowButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource TopStashArrowButtonStyle}">
            <Setter Property="Width"
                    Value="22" />
            <Setter Property="Height"
                    Value="30" />
        </Style>
    </Window.Resources>

    <Border x:Name="CapsuleSurface"
            Width="170"
            Height="36"
            Padding="12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource CompactCapsuleSurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            ClipToBounds="True"
            Cursor="Hand"
            PreviewMouseLeftButtonDown="OnCapsulePreviewMouseLeftButtonDown"
            PreviewMouseRightButtonDown="OnCapsulePreviewMouseRightButtonDown"
            SizeChanged="OnCapsuleSurfaceSizeChanged"
            RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CapsuleSurfaceScale"
                                ScaleX="1"
                                ScaleY="1" />
                <TranslateTransform x:Name="CapsuleSurfaceTranslate" />
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid x:Name="QuickMenuContent"
                  Margin="16,7"
                  Opacity="0"
                  RenderTransformOrigin="0.5,0"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="QuickMenuTranslate"
                                        Y="-6" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="10">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="⋯" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="快捷操作" />
                        <TextBlock Margin="8,0,0,0"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="从胶囊内直接启动" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="24"
                            Height="24"
                            Margin="0"
                            Click="OnQuickMenuCloseClick"
                            Content="×"
                            FontSize="13"
                            Style="{StaticResource QuickMenuButtonStyle}"
                            ToolTip="收起快捷操作" />
                </Grid>

                <UniformGrid Grid.Row="1"
                             Margin="0,3,0,0"
                             Columns="5"
                             Rows="2">
                    <Button x:Name="QuickToggleButton"
                            Click="OnContextToggleClick"
                            Content="展开/收起"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button x:Name="QuickDoNotDisturbButton"
                            Click="OnContextDoNotDisturbClick"
                            Content="勿扰：关"
                            Style="{StaticResource QuickMenuButtonStyle}"
                            ToolTip="只控制胶囊事件弹窗，不跟随 Windows 请勿打扰" />
                    <Button Click="OnContextCountdownFiveClick"
                            Content="5 分钟"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button Click="OnContextCountdownFifteenClick"
                            Content="15 分钟"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button Click="OnContextCountdownTwentyFiveClick"
                            Content="25 分钟"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button Click="OnContextCountdownClick"
                            Content="自定义倒计时"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button Click="OnContextWindowsStopwatchClick"
                            Content="Windows 秒表"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button Click="OnContextSettingsClick"
                            Content="设置"
                            Style="{StaticResource QuickMenuButtonStyle}" />
                    <Button Click="OnContextExitClick"
                            Content="彻底退出"
                            Style="{StaticResource QuickMenuDangerButtonStyle}" />
                </UniformGrid>
            </Grid>

            <StackPanel x:Name="CompactContent"
                        Margin="2,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Opacity="1"
                        RenderTransformOrigin="0.5,0.5"
                        Orientation="Horizontal">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="CompactContentScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </StackPanel.RenderTransform>
                <Ellipse Width="7"
                         Height="7"
                         Margin="0,0,8,0"
                         Fill="#58D68D" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource CapsuleFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="Dynamic Capsule" />
            </StackPanel>

            <StackPanel x:Name="PowerOffContent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                <TextBlock Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI Symbol"
                           FontSize="13"
                           Foreground="{DynamicResource AccentLabelBrush}"
                           Text="⏻" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource CapsuleFont}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="点击启动" />
            </StackPanel>

            <Grid x:Name="MediaCompactContent"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MediaCompactContentScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38"
                        Height="38"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="9">
                    <Grid>
                        <Image x:Name="MediaCompactArtworkImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,38,38"
                                                   RadiusX="9"
                                                   RadiusY="9" />
                            </Image.Clip>
                        </Image>
                        <TextBlock x:Name="MediaCompactArtworkFallback"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="♪" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="MediaCompactTitle"
                               Width="224"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaCompactLyricsText"
                               Width="224"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="9.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="♪ 正在查找歌词…"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock x:Name="MediaCompactPlaybackIcon"
                           Grid.Column="2"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource CapsuleFont}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="▶" />
            </Grid>

            <Grid x:Name="MediaEventCompactContent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="MediaEventCompactContentScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Grid.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="MediaEventCompactMusicPanel"
                                Cursor="Hand"
                                Orientation="Horizontal"
                                ToolTip="展开音乐">
                        <Border Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Image x:Name="MediaEventCompactArtworkImage"
                                   Width="28"
                                   Height="28"
                                   Stretch="UniformToFill"
                                   Visibility="Collapsed">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,28,28"
                                                       RadiusX="8"
                                                       RadiusY="8" />
                                </Image.Clip>
                            </Image>
                            <TextBlock x:Name="MediaEventCompactArtworkFallback"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CapsuleFont}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Text="♪" />
                        </Grid>
                        </Border>

                        <StackPanel Width="72"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="MediaEventCompactTitleText"
                                       FontFamily="{StaticResource CapsuleFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MediaEventCompactArtistText"
                                       Margin="0,1,0,0"
                                       FontFamily="{StaticResource CapsuleFont}"
                                       FontSize="8"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <Border Width="1"
                            Height="22"
                            Margin="9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BorderBrush}" />

                    <Grid x:Name="MediaEventCompactActivityPanel"
                          Width="24"
                          Height="24"
                          Cursor="Hand"
                          ToolTip="展开计时器"
                          VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource ProgressTrackBrush}"
                                 StrokeThickness="2.5" />
                        <Path x:Name="MediaEventCompactProgressPath"
                              Stroke="{DynamicResource ProgressBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="2.5" />
                        <TextBlock x:Name="MediaEventCompactGlyphText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="◷" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid x:Name="EventCompactContent"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="EventCompactContentScale"
                                    ScaleX="1"
                                    ScaleY="1" />
                </Grid.RenderTransform>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="28"
                          Height="28"
                          VerticalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource ProgressTrackBrush}"
                                 StrokeThickness="3" />
                        <Path x:Name="PrimaryCompactProgressPath"
                              Stroke="{DynamicResource ProgressBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="3" />
                        <TextBlock x:Name="PrimaryCompactGlyphText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="◷" />
                    </Grid>

                    <StackPanel Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PrimaryCompactTimeText"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="00:00" />
                        <TextBlock x:Name="PrimaryCompactTitleText"
                                   Width="62"
                                   Margin="0,1,0,0"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border x:Name="SecondaryCompactSeparator"
                            Width="1"
                            Height="22"
                            Margin="9,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource BorderBrush}"
                            Visibility="Collapsed" />

                    <Grid x:Name="SecondaryCompactPanel"
                          Width="24"
                          Height="24"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                        <Ellipse Stroke="{DynamicResource ProgressTrackBrush}"
                                 StrokeThickness="2.5" />
                        <Path x:Name="SecondaryCompactProgressPath"
                              Stroke="{DynamicResource ProgressBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="2.5" />
                        <TextBlock x:Name="SecondaryCompactGlyphText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="↗" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid x:Name="EventAlertContent"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.2"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="EventAlertScale"
                                        ScaleX="1"
                                        ScaleY="1" />
                        <TranslateTransform x:Name="EventAlertTranslate" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="EventGlyphSurface"
                        Width="42"
                        Height="42"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="13"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="EventGlyphScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                            <RotateTransform x:Name="EventGlyphRotate" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <TextBlock x:Name="EventGlyphText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Text="!" />
                </Border>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EventSourceText"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLabelBrush}"
                                   Text="Windows 通知"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PinnedIndicatorText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLabelBrush}"
                                   Text="● 已固定"
                                   Visibility="Collapsed" />
                    </Grid>
                    <TextBlock x:Name="EventTitleText"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="新通知"
                               TextTrimming="CharacterEllipsis" />
                    <Grid x:Name="EventDetailRow"
                          Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="EventBodyText"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EventProgressText"
                                   Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ProgressBar x:Name="EventProgressBar"
                                 Height="3"
                                 Margin="0,4,0,0"
                                 Background="{DynamicResource ProgressTrackBrush}"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource ProgressBrush}"
                                 Maximum="1"
                                 Minimum="0"
                                 Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="EventActionPanel"
                            Grid.Column="3"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="TimerPauseResumeButton"
                            Click="OnTimerPauseResumeButtonClick"
                            Content="Ⅱ"
                            Style="{StaticResource EventActionButtonStyle}"
                            ToolTip="暂停计时" />
                    <Button x:Name="TimerCancelButton"
                            Click="OnTimerCancelButtonClick"
                            Margin="0,4,0,0"
                            Content="×"
                            Style="{StaticResource EventActionButtonStyle}"
                            ToolTip="取消计时" />
                </StackPanel>
            </Grid>

            <Border x:Name="SecondaryEventContent"
                    Width="98"
                    Height="56"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="9,7"
                    Background="{DynamicResource SubtleSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Opacity="1"
                    RenderTransformOrigin="0.5,0.5"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SecondaryEventTranslate" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SecondaryEventGlyphSurface"
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12">
                        <TextBlock x:Name="SecondaryEventGlyphText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="↗" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="SecondaryEventTitleText"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SecondaryEventStatusText"
                                   Margin="0,2,0,0"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="8"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ExpandedContent"
                  Opacity="1"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ExpandedContentTranslate" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="94" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Border Width="84"
                        Height="84"
                        Margin="2,0,0,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="19"
                        ClipToBounds="True">
                    <Grid>
                        <TextBlock x:Name="ArtworkFallback"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentLabelBrush}"
                                   Text="♪" />
                        <Image x:Name="ArtworkImage"
                               CacheMode="BitmapCache"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Stretch="UniformToFill"
                               Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Top">
                    <TextBlock x:Name="MediaTitleText"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="未检测到媒体"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaArtistText"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="播放音乐或视频后自动显示"
                               TextTrimming="CharacterEllipsis" />
                    <Border Margin="0,4,0,0"
                            Padding="8,3"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            CornerRadius="6">
                        <TextBlock x:Name="LyricsText"
                                   FontFamily="{StaticResource CapsuleFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="♪ 歌词将在播放后显示"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TextBlock x:Name="MediaSourceText"
                               Margin="1,2,0,0"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="9"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="左键收起 · 右键退出验证"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="PowerToggleButton"
                        Grid.Column="4"
                        Click="OnPowerToggleButtonClick"
                        Width="28"
                        Height="28"
                        Margin="0,0,2,0"
                        VerticalAlignment="Top"
                        Content="⏻"
                        FontFamily="Segoe UI Symbol"
                        Style="{StaticResource MediaButtonStyle}"
                        ToolTip="完全退出 Dynamic Capsule" />

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="5"
                      Margin="3,5,3,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MediaElapsedText"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="0:00" />
                    <Grid x:Name="MediaProgressHitTarget"
                          Grid.Column="1"
                          Height="28"
                          Margin="6,0"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Cursor="SizeWE"
                          LostMouseCapture="OnMediaProgressLostMouseCapture"
                          PreviewMouseLeftButtonDown="OnMediaProgressPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnMediaProgressPreviewMouseMove"
                          PreviewMouseLeftButtonUp="OnMediaProgressPreviewMouseLeftButtonUp"
                          ToolTip="点击或拖动以调整播放位置">
                        <Border Height="5"
                                VerticalAlignment="Center"
                                Background="#46FFFFFF"
                                CornerRadius="2.5" />
                        <Border x:Name="MediaProgressFill"
                                Width="0"
                                Height="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="2.5" />
                        <Border x:Name="MediaProgressThumb"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="White"
                                CornerRadius="7">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="MediaProgressThumbTranslate"
                                                    X="-7" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="MediaRemainingText"
                               Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource CapsuleFont}"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="−0:00" />
                </Grid>

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="PreviousButton"
                            Click="OnPreviousButtonClick"
                            Content="⏮"
                            IsEnabled="False"
                            Style="{StaticResource ExpandedMediaButtonStyle}"
                            ToolTip="上一首" />
                    <Button x:Name="PlayPauseButton"
                            Click="OnPlayPauseButtonClick"
                            Content="▶"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryMediaButtonStyle}"
                            ToolTip="播放或暂停" />
                    <Button x:Name="NextButton"
                            Click="OnNextButtonClick"
                            Content="⏭"
                            IsEnabled="False"
                            Style="{StaticResource ExpandedMediaButtonStyle}"
                            ToolTip="下一首" />
                </StackPanel>
            </Grid>
            <Border x:Name="TopStashHandle"
                    Width="84"
                    Height="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#FF7288FF"
                    CornerRadius="3"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TopStashHandleTranslate" />
                </Border.RenderTransform>
            </Border>
            <Button x:Name="TopStashArrowButton"
                    Margin="0,0,-26,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="20"
                    Click="OnTopStashArrowClick"
                    Style="{StaticResource SideTopStashArrowButtonStyle}"
                    ToolTip="收纳到屏幕顶部" />
            <Button x:Name="MediaTopStashArrowButton"
                    Margin="0,0,23,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="20"
                    Click="OnTopStashArrowClick"
                    Style="{StaticResource SideTopStashArrowButtonStyle}"
                    ToolTip="收纳到屏幕顶部"
                    Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
