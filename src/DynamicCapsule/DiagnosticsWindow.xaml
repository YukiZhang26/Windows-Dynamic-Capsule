<Window x:Class="DynamicCapsule.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Capsule 诊断状态"
        Width="560"
        Height="560"
        Background="{DynamicResource WindowSurfaceBrush}"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="OnPreviewKeyDown"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentLabelBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Text="诊断状态" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="只显示运行状态和路径，不包含通知或任务正文。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,14"
                      TabIndex="0"
                      Focusable="True"
                      AutomationProperties.Name="诊断状态详情"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="进程与实例" />
                <TextBlock x:Name="ProcessText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="包与版本" />
                <TextBlock x:Name="PackageText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="媒体" />
                <TextBlock x:Name="MediaText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="Windows 通知" />
                <TextBlock x:Name="NotificationText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="本地任务管道" />
                <TextBlock x:Name="TaskPipeText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="计时器" />
                <TextBlock x:Name="TimerText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="当前事件" />
                <TextBlock x:Name="ActiveEventText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="配置" />
                <TextBlock x:Name="ConfigurationText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="登录启动" />
                <TextBlock x:Name="StartupText" FontSize="12" />
                <TextBlock Style="{StaticResource LabelStyle}" Text="辅助功能" />
                <TextBlock x:Name="AccessibilityText" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <TextBlock x:Name="CopyStatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource AccentLabelBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="108"
                        Height="32"
                        Margin="0,0,8,0"
                        TabIndex="1"
                        Click="OnCopyClick"
                        Content="复制摘要(_C)" />
                <Button Width="88"
                        Height="32"
                        TabIndex="2"
                        IsCancel="True"
                        Click="OnCloseClick"
                        Content="关闭(_X)" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
