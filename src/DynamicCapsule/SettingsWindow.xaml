<Window x:Class="DynamicCapsule.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dynamic Capsule · 控制中心" Width="760" Height="650" WindowStyle="None" ResizeMode="NoResize"
 Background="{DynamicResource WindowSurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
 ShowInTaskbar="False" KeyboardNavigation.TabNavigation="Cycle" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="54" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="16"/></WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ControlPanelStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,24"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Nav" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource SubtleSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary></Window.Resources>
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
  <Grid Margin="24,0,16,0">
   <TextBlock Text="Dynamic Capsule" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button Content="×" AutomationProperties.Name="关闭设置" ToolTip="关闭，不保存更改" Width="32" MinWidth="32" MinHeight="30" Padding="0" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCancelClick" WindowChrome.IsHitTestVisibleInChrome="True"/>
  </Grid>
  <TabControl x:Name="SettingsTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="12" Margin="12,0,0,12" Padding="8,16"><StackPanel IsItemsHost="True"/></Border>
    <Border x:Name="PageSurface" Grid.Column="1" Padding="28,12,28,0" ClipToBounds="True"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border>
   </Grid></ControlTemplate></TabControl.Template>
   <TabItem AutomationProperties.Name="外观与行为">
    <TabItem.Header><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" Background="#3478F6" CornerRadius="8" Margin="0,0,10,0"><Path Data="M 3,4 L 19,4 L 19,15 L 3,15 Z M 7,19 L 15,19 M 11,15 L 11,19" Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="外观与行为" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="外观与行为" Style="{StaticResource Heading}"/><TextBlock Text="安静融入桌面，在需要时恰好出现。" Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="显示位置" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <ComboBox x:Name="MonitorTargetCombo" Height="38" AutomationProperties.Name="胶囊显示位置"><ComboBoxItem Content="跟随当前活动窗口"/><ComboBoxItem Content="始终显示在主显示器"/></ComboBox>
     <DockPanel Margin="0,22,0,8"><TextBlock x:Name="TopGapValueText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="距屏幕顶部"/></DockPanel>
     <Slider x:Name="TopGapSlider" Minimum="0" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="顶部间距"/>
     <DockPanel Margin="0,18,0,8"><TextBlock x:Name="TransparencyValueText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}"/><TextBlock Text="胶囊背景透明度"/></DockPanel>
     <Slider x:Name="TransparencySlider" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="胶囊背景透明度"/>
     <TextBlock Text="0% 为不透明；仅调整背景，文字和封面保持清晰。" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <CheckBox x:Name="EnableAnimationsCheckBox" Content="流畅动画"/><CheckBox x:Name="HideInFullscreenCheckBox" Content="全屏时自动隐藏"/><CheckBox x:Name="StartWithWindowsCheckBox" Content="登录时启动"/>
    </StackPanel></Border>
    <TextBlock x:Name="SystemAccessibilityText" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,16"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem AutomationProperties.Name="通知与专注">
    <TabItem.Header><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" Background="#AF52DE" CornerRadius="8" Margin="0,0,10,0"><Path Data="M 15,3 C 5,1 0,12 7,18 C 12,23 20,19 21,14 C 13,17 9,8 15,3 Z" Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="通知与专注" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="通知与专注" Style="{StaticResource Heading}"/><TextBlock Text="决定哪些消息值得打断你。" Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><Ellipse x:Name="NotificationStatusDot" Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource AccentBrush}"/><TextBlock x:Name="NotificationStatusTitleText" FontWeight="SemiBold"/></DockPanel>
     <TextBlock x:Name="NotificationStatusMessageText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,10,0,16" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Orientation="Horizontal" Margin="-8,0,0,0"><Button x:Name="OpenNotificationSettingsButton" Content="系统权限" Click="OnOpenNotificationSettingsClick"/><Button x:Name="PreviewNotificationButton" Content="预览通知" Click="OnPreviewNotificationClick"/></StackPanel>
     <TextBlock x:Name="NotificationActionStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource AccentLabelBrush}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <CheckBox x:Name="DoNotDisturbCheckBox" Content="消息勿扰" AutomationProperties.HelpText="独立于 Windows 请勿打扰。仅静音胶囊消息通知。"/>
     <TextBlock Text="仅静音消息。计时、下载和连接提醒照常显示。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,20"/>
     <CheckBox x:Name="AiMonitorCheckBox" Content="显示 AI 生成状态（实验性）" ToolTip="观察本机 ChatGPT、豆包及浏览器当前 ChatGPT 标签的生成控件；不保存对话。" Margin="0,0,0,14"/>
     <TextBlock Text="通知内容" Margin="0,0,0,10"/>
     <ComboBox x:Name="PrivacyLevelCombo" Height="38" AutomationProperties.Name="事件隐私级别"><ComboBoxItem Content="完整内容"/><ComboBoxItem Content="简短摘要"/><ComboBoxItem Content="隐藏标题与正文"/><ComboBoxItem Content="仅图标"/></ComboBox>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="只接收这些应用" Margin="0,0,0,8"/><TextBox x:Name="NotificationAllowListTextBox" Height="64" Padding="10" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="通知允许列表"/>
     <TextBlock Text="每行一个应用名称；留空表示不限制。" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,18"/>
     <TextBlock Text="屏蔽这些应用" Margin="0,0,0,8"/><TextBox x:Name="NotificationBlockListTextBox" Height="64" Padding="10" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="通知屏蔽列表"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem AutomationProperties.Name="音乐与歌词">
    <TabItem.Header><StackPanel Orientation="Horizontal"><Border Width="28" Height="28" Background="#FF375F" CornerRadius="8" Margin="0,0,10,0"><Path Data="M 8,17 L 8,5 L 20,2 L 20,14 M 8,8 L 20,5 M 8,17 C 8,21 1,22 1,18 C 1,15 8,14 8,17 M 20,14 C 20,18 13,19 13,15 C 13,12 20,11 20,14" Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="音乐与歌词" VerticalAlignment="Center"/></StackPanel></TabItem.Header>
    <StackPanel>
    <TextBlock Text="音乐与歌词" Style="{StaticResource Heading}"/><TextBlock Text="跟随正在播放的音乐。" Style="{StaticResource Caption}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="备用歌词来源" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ComboBox x:Name="LyricsFallbackProviderCombo" Height="38" AutomationProperties.Name="备用歌词来源"><ComboBoxItem Content="关闭备用来源"/><ComboBoxItem Content="QQ 音乐"/></ComboBox>
     <TextBlock Text="在线歌词取决于来源可用性。短暂失败会自动重试，已缓存的同步歌词可离线使用。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,16,0,0" FontSize="12" LineHeight="20"/>
    </StackPanel></Border>
    <TextBlock x:Name="SettingsPathText" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="2,8,0,0"/>
   </StackPanel></TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,16"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Click="OnCancelClick"/><Button Content="保存更改" IsDefault="True" Click="OnSaveClick" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel>
   <TextBlock Text="按你的方式，保持专注。" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
  </DockPanel></Border>
 </Grid></Border>
</Window>
